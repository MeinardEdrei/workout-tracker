MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/workout-tracker?retryWrites=true&w=majority
PORT=3001
CLIENT_URL=http://localhost:5173

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# JWT — use a random string of at least 32 characters
JWT_SECRET=change_me_to_a_long_random_string_at_least_32_chars

# Session — used only for the OAuth CSRF state during redirect
SESSION_SECRET=change_me_to_another_long_random_string

# Admin — this email gets access to /api/admin/* and the Admin page
ADMIN_EMAIL=youremail@gmail.com
